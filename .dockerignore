# VCS / editors
.git
.gitignore
**/.DS_Store
**/__pycache__
**/*.pyc
.pytest_cache
**/.pytest_cache

# Python virtualenvs and local artifacts
backend/.venv
.venv
# Local ML experiment artifacts stay out of images — except the committed
# ACTIVE diagnosis model files (active RF ~9.8 MB, its LR rollback ~10 KB,
# plus the tiny diagnosis_active.json pointer) so container diagnosis
# matches local demo diagnosis deterministically.
backend/artifacts/*
!backend/artifacts/diagnosis_active.json
!backend/artifacts/diagnosis_logistic_regression_v20260826T234303Z-c5434878.joblib
!backend/artifacts/diagnosis_random_forest_v20260828T013109Z-77a4ef3b.joblib

# Node / Next.js
**/node_modules
**/.next

# Local databases and env files (never bake data or secrets into images)
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Docs and contracts are not needed at runtime image build time
docs
contracts
