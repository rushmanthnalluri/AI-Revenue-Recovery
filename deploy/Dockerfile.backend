# Backend image. Python 3.12 in Docker for maximum wheel compatibility
# (local dev runs 3.14; pinned requirements install on both).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

COPY backend/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ ./
# Policy files live at repo root; the image expects them at /srv/policies.
COPY policies/ ./policies/

EXPOSE 8000

# Migrate then serve. DATABASE_URL is injected by docker-compose.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
