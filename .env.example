# PulseRecover — example environment. Copy to .env and fill in. NEVER commit real secrets.
DATABASE_URL=sqlite:///./pulserecover.db
APP_ENV=dev
SIMULATION_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
API_KEY=dev-key
# JSON array form — pydantic-settings JSON-decodes list-valued env vars,
# so a bare comma string can fail to parse at startup.
CORS_ORIGINS=["http://localhost:3000"]
POLICY_FILE=policies/default.yaml
LOG_LEVEL=INFO
