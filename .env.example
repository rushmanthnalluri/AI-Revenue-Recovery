# PulseRecover — example environment. Copy to .env and fill in. NEVER commit real secrets.
DATABASE_URL=sqlite:///./pulserecover.db
APP_ENV=dev
SIMULATION_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=
API_KEY=dev-key
CORS_ORIGINS=http://localhost:3000
POLICY_FILE=policies/default.yaml
LOG_LEVEL=INFO
