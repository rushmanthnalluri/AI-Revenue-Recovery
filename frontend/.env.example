# PulseRecover frontend environment template. Copy to .env.local. NEVER commit real secrets.
# Base URL of the PulseRecover API (FastAPI backend).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# API key sent as X-API-Key on mutating /api/v1 calls. Match backend API_KEY.
NEXT_PUBLIC_API_KEY=dev-key
